{
  "info": {
    "name": "Books API — Lab 03",
    "description": "Lab 3: Newman-runnable collection with 5 happy-path tests and 2 error-path tests for Books API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "happy-path",
      "item": [
        {
          "name": "GET /books — initial list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /books — create",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"DDIA\", \"author\": \"Kleppmann\", \"year\": 2017}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response has positive id', () => pm.expect(pm.response.json().id).to.be.above(0));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('book_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /books/{id} — read created book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{book_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Has expected fields', () => pm.expect(pm.response.json()).to.have.all.keys('id', 'title', 'author', 'year', 'isbn'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /books/{id} — update",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{book_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"DDIA revised\", \"author\": \"Kleppmann\", \"year\": 2017}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Title was updated', () => pm.expect(pm.response.json().title).to.eql('DDIA revised'));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /books/{id} — delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{book_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Empty body', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "error-cases",
      "item": [
        {
          "name": "POST /books — missing title (400)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"author\": \"No Title Author\", \"year\": 2024}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is VALIDATION_ERROR', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('Errors mention title field', () => {",
                  "  const errors = pm.response.json().errors;",
                  "  pm.expect(errors).to.be.an('array');",
                  "  const hasTitle = errors.some(e => e.field === 'title');",
                  "  pm.expect(hasTitle).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /books/9999 — not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/9999",
              "host": ["{{base_url}}"],
              "path": ["books", "9999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('Error code is NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "book_id",
      "value": ""
    }
  ]
}
