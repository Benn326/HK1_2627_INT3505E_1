    {
      "name": "4. Create Book (Valid JSON Schema)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Microservices Patterns\",\n  \"isbn\": \"978-1617294549\",\n  \"price_vnd\": 420000,\n  \"stock\": 10,\n  \"category_id\": 1,\n  \"author_ids\": [1]\n}"
        },
