{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderResource",
  "type": "object",
  "required": ["user_id", "items"],
  "properties": {
    "id": { "type": "integer", "readOnly": true },
    "user_id": { 
      "type": "integer",
      "description": "Khách hàng sở hữu lịch sử đơn hàng này"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "completed", "cancelled"],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "description": "Đơn hàng chứa nhiều sách, mỗi sách kèm số lượng (SL)",
      "items": {
        "type": "object",
        "required": ["book_id", "quantity"],
        "properties": {
          "book_id": { "type": "integer" },
          "quantity": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}