# Development (SQLite local mặc định hoặc Docker Compose Postgres dev)
DB_URL=sqlite:///dev.db
# DB_URL=postgresql+psycopg://app:devpw@db/appdb
SECRET_KEY=dev-not-for-prod
APP_CONFIG=product_api.config.DefaultConfig
LOG_LEVEL=INFO

# Production (Không commit secret thật lên Git; truyền qua biến môi trường/Secret Manager)
# DB_URL=postgresql+psycopg://<prod_user>:<prod_password>@<prod_host>:5432/<prod_db>
# SECRET_KEY=<sinh-bằng-secrets-token-urlsafe-32>
# APP_CONFIG=product_api.config.ProductionConfig
# LOG_LEVEL=WARNING
